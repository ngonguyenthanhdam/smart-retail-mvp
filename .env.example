# Copy this file to backend/.env. Match the credentials to your local PostgreSQL.
# URL-encode reserved characters in the password when writing DATABASE_URL.
DATABASE_URL=postgresql://retailsense:change_me_for_local_development@localhost:5432/retailsense?schema=public
PORT=3001
ML_SERVICE_URL=http://localhost:8000
# Optional local business chatbot. Run Setup-AI.bat separately on Windows.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
INVENTORY_EXPIRY_WARNING_DAYS=7

# Browser origin must use the same hostname as the API for local cookies.
FRONTEND_ORIGIN=http://localhost:3000
NODE_ENV=development
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Bootstrap once; subsequent seeds do not reset the existing administrator.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_FULL_NAME=

# Dedicated database for integration tests. Database name must end with _test.
TEST_DATABASE_URL=

# Local SMTP inbox for password-recovery demos. Use provider settings for real mail.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@retailsense.local
